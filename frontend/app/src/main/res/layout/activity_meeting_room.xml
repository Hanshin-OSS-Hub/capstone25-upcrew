    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color">

        <!-- 헤더 -->
        <include
            android:id="@+id/include_header"
            layout="@layout/view_top_header"
            android:layout_width="0dp"
            android:layout_height="180dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 하단 네비 -->
        <include
            android:id="@+id/include_bottom_nav"
            layout="@layout/view_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 스크롤 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/include_header"
            app:layout_constraintBottom_toTopOf="@id/include_bottom_nav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 제목 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="경삼관 | 3F | 회의실"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 캘린더 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="좌석 예약"
                            android:textColor="@color/black"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="날짜와 시간을 입력하세요"
                            android:textColor="@color/gray"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginTop="10dp"/>

                        <CalendarView
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxDate="12/31/2030"
                            android:minDate="01/01/2026" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 시간 선택 카드 -->
                <!-- 시간 선택 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/timeGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="09:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="10:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="11:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="12:00"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="13:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="14:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="15:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="16:00"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="17:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="18:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="19:00"/>
                                <com.google.android.material.button.MaterialButton
                                    style="@style/TimeButton"
                                    android:layout_weight="1"
                                    android:text="20:00"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 예약 버튼 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReserve"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="예약하기"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/light_purple"
                    app:cornerRadius="12dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>