<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <include
        android:id="@+id/include_header"
        layout="@layout/view_top_header"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 스크롤 영역-->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/include_header"
        app:layout_constraintBottom_toTopOf="@id/include_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!--            6관-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp"
                app:cardElevation="1dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp">

                        <ImageView
                            android:id="@+id/ivPhoto6"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hs_building_6"
                            android:contentDescription="@null"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_img_bottom_fade"/>
                    </FrameLayout>


                    <LinearLayout
                        android:id="@+id/rowHeader6"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="@color/white">

                        <TextView
                            android:id="@+id/tvTitle6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/building_6_title"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <ImageButton
                            android:id="@+id/btnToggle6"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:srcCompat="@drawable/ic_expand_more_24"
                            app:tint="@color/black"
                            android:rotation="0"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"/>

                    <LinearLayout
                        android:id="@+id/sectionContent6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:background="@color/gray_card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_1_komjirak"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="예시"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="1dp"
                                android:background="@drawable/chip_base"
                                app:backgroundTint="@color/chip_busy"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_1_lounge"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="예시"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="1dp"
                                android:background="@drawable/chip_base"
                                app:backgroundTint="@color/chip_normal"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_1_lounge_front"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="예시"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="1dp"
                                android:background="@drawable/chip_base"
                                app:backgroundTint="@color/chip_free"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_3_meeting"/>
                            <TextView
                                android:id="@+id/btnReserveMeeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_reserve"
                                android:textSize="12sp"
                                android:textColor="@color/click_text"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:id="@+id/btnHistoryMeeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_history"
                                android:textSize="12sp"
                                android:textColor="@color/click_text"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_4_reading"/>
                            <TextView
                                android:id="@+id/btnReserveStudyroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_reserve"
                                android:textSize="12sp"
                                android:textColor="@color/click_text"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:id="@+id/btnHistoryStudyroom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_history"
                                android:textSize="12sp"
                                android:textColor="@color/click_text"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--            9관-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp"
                app:cardElevation="1dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp">

                        <ImageView
                            android:id="@+id/ivPhoto9"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hs_building_9"
                            android:contentDescription="@null"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_img_bottom_fade"/>
                    </FrameLayout>


                    <LinearLayout
                        android:id="@+id/rowHeader9"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="@color/white"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvTitle9"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="9관 │ 학과실습동"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <ImageButton
                            android:id="@+id/btnToggle9"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:srcCompat="@drawable/ic_expand_more_24"
                            app:tint="@color/black"
                            android:rotation="0"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"/>

                    <LinearLayout
                        android:id="@+id/sectionContent9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:background="#E0E0E0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_1_kumteul"/>
                            <TextView
                                android:id="@+id/tvCongestion9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="loading"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="1dp"
                                android:background="@drawable/chip_base"
                                app:backgroundTint="@color/chip_free"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--            18관-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp"
                app:cardElevation="1dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp">

                        <ImageView
                            android:id="@+id/ivPhoto18"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hs_building_18"
                            android:contentDescription="@null"
                            android:clickable="true"
                            android:focusable="true"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_img_bottom_fade"/>
                    </FrameLayout>


                    <LinearLayout
                        android:id="@+id/rowHeader18"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="@color/white">

                        <TextView
                            android:id="@+id/tvTitle18"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/building_18_title"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <ImageButton
                            android:id="@+id/btnToggle18"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:srcCompat="@drawable/ic_expand_more_24"
                            app:tint="@color/black"
                            android:rotation="0"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"/>

                    <LinearLayout
                        android:id="@+id/sectionContent18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:background="#E0E0E0"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/floor_1_lounge"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="구현 예정"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="1dp"
                                android:background="@drawable/chip_base"
                                app:backgroundTint="@color/gray"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--    네비게이션 바-->
    <include
        android:id="@+id/include_bottom_nav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>